<?xml version="1.0" encoding="utf-8"?>
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="com.openbangla.keyboard.ui.settings.SettingsActivity"
    android:isDefault="true">
    <subtype
        android:label="@string/subtype_bengali_avro"
        android:imeSubtypeLocale="bn_BD"
        android:imeSubtypeMode="keyboard"
        android:imeSubtypeExtraValue="KeyboardLayoutSet=bengali_avro,AsciiCapable" />
    <subtype
        android:label="@string/subtype_bengali_fixed"
        android:imeSubtypeLocale="bn_BD"
        android:imeSubtypeMode="keyboard"
        android:imeSubtypeExtraValue="KeyboardLayoutSet=bengali_fixed" />
    <subtype
        android:label="@string/subtype_english"
        android:imeSubtypeLocale="en_US"
        android:imeSubtypeMode="keyboard"
        android:imeSubtypeExtraValue="KeyboardLayoutSet=english,AsciiCapable" />
</input-method>
